<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalculateurAge.MainPage"
    Title="Calculateur">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="12">

            <Label
                Text="Calculateur d'âge"
                FontSize="28"
                HorizontalOptions="Center" />

            <Label
                Text="Nom"
                FontSize="16" />

            <Entry
                Text="{Binding Nom, Mode=TwoWay}"
                Placeholder="Votre nom" />

            <Label
                Text="Date de naissance"
                FontSize="16" />

            <DatePicker
                Date="{Binding DateNaissance}" />

            <Button
                Text="Calculer"
                Command="{Binding CalculerCommand}" />

            <Button
                Text="Effacer"
                Command="{Binding EffacerCommand}" />

            <Label
                Text="{Binding Resultat}"
                FontSize="20"
                HorizontalOptions="Center"
                IsVisible="{Binding ResultatVisible}" />

            <Label
                Text="{Binding Message}"
                FontSize="20"
                HorizontalOptions="Center"
                IsVisible="{Binding MessageVisible}" />

            <Label
                Text="{Binding JoursAvantAnniversaire}"
                FontSize="16"
                HorizontalOptions="Center"
                IsVisible="{Binding JoursVisible}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>